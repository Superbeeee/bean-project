# Firebase 設定（VITE_DATA_PROVIDER=firebase 時必填）
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# Data Provider 切換（firebase | local，預設 firebase）
VITE_DATA_PROVIDER=firebase

# 本地後端 API URL（VITE_DATA_PROVIDER=local 時使用）
VITE_API_BASE_URL=http://localhost:3000

# Google Sheets i18n sync
GOOGLE_SHEET_ID=your-sheet-id
GOOGLE_SHEETS_API_KEY=your-api-key

# ── 以下為 server/ 使用的環境變數（.env 放在根目錄，server 啟動時讀取）──

# JWT 簽署密鑰（請換成隨機長字串）
SERVER_JWT_SECRET=change-me-to-a-random-secret

# Google OAuth（VITE_DATA_PROVIDER=local 且使用 Google 登入時必填）
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/auth/google/callback

# 前端 URL（OAuth callback 後 redirect 目標）
FRONTEND_URL=http://localhost:5173
